{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "file"
  ],
  "properties": {
    "file": {
      "title": "结果库路径",
      "anyOf": [
        {
          "type": "string",
          "description": "单个结果库路径（.db/.sqlite）"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "多个结果库路径（合并导出：逐库读取按来源分组排序）"
        }
      ],
      "description": "commOcr 结果库路径；传数组即多库合并（AJ1）"
    },
    "long_value_chars": {
      "title": "长值阈值",
      "type": "integer",
      "minimum": 1,
      "description": "长值阈值，默认 200"
    },
    "mode": {
      "title": "提取模式",
      "type": "string",
      "enum": [
        "units",
        "records"
      ],
      "description": "units=翻译单元（默认）；records=原始记录数组（视图流用）"
    }
  }
}