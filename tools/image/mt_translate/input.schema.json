{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["file"],
  "properties": {
    "file": {"title": "图片文件路径", "type": "string", "description": "png/jpg/jpeg/webp/tif/tiff/bmp 图片路径"},
    "model": {
      "title": "图片翻译模型",
      "type": ["string", "null"],
      "default": "qwen-mt-image-2.0",
      "description": "留空 = qwen-mt-image-2.0（0.004 元/张，RPM=1）"
    },
    "fallback_model": {
      "title": "备用模型",
      "type": ["string", "null"],
      "default": "qwen-mt-image",
      "description": "主模型不可用/任务失败时自动降级；留空则失败即报错"
    },
    "source_lang": {"title": "源语言", "type": ["string", "null"], "description": "留空自动识别"},
    "target_lang": {"title": "目标语言", "type": ["string", "null"], "default": "Chinese"},
    "terms": {
      "title": "术语表",
      "type": ["array", "string", "null"],
      "description": "术语干预：[[原文,译文],...] 或每行「原文 => 译文」"
    },
    "domain_hint": {"title": "领域提示", "type": ["string", "null"], "description": "如 finance / legal，影响译法"},
    "sensitives": {
      "title": "敏感词",
      "type": ["array", "null"],
      "items": {"type": "string"},
      "description": "不翻译的敏感词列表"
    },
    "image_segment": {
      "title": "主体分割",
      "type": ["boolean", "null"],
      "default": false,
      "description": "只翻译主体区域（商品图等）"
    },
    "key_name": {"title": "密钥名", "type": ["string", "null"], "description": "留空用默认密钥"},
    "base_url": {"title": "原生 API 地址", "type": ["string", "null"], "description": "留空由密钥 base_url 自动推导"},
    "output_name": {"title": "产物文件名", "type": ["string", "null"]}
  }
}
