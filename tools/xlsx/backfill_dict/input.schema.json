{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["units", "col_classes", "ranges", "segments", "index_map", "date_maps", "translations", "statuses"],
  "properties": {
    "units": {"title": "单元组", "type": "array", "description": "提取工具输出的单元组"},
    "col_classes": {"title": "列类型映射", "type": "object", "description": "classify 的 col_classes"},
    "ranges": {"title": "分类区间", "type": "array", "description": "classify 的 ranges"},
    "segments": {"title": "收割段落", "type": "array", "items": {"type": "string"}, "description": "classify 的收割段（对照字典原文列）"},
    "index_map": {"title": "单元索引映射", "type": "array", "items": {"type": "integer"}},
    "date_maps": {"title": "日期映射", "type": "array", "items": {"type": "object"}},
    "translations": {"title": "译文数组", "type": "array", "items": {"type": "string"}},
    "statuses": {"title": "状态标记", "type": "array", "items": {"enum": ["ok", "review"]}},
    "file": {"title": "源文件路径", "type": "string", "description": "源文件路径（sheets 版式下作为副本母本，只读；产物命名用）"},
    "layout": {"title": "产物版式", "type": "string", "enum": ["sheets", "dict"],
               "description": "sheets（默认）：原文件副本上每个 sheet 之后插入 <sheet名>_翻译结果；dict：旧行为（每单元一张 sheet + 对照字典）"},
    "out_name": {"title": "产物文件名", "type": "string", "description": "产物文件名；缺省 <源名>_中文.xlsx"}
  }
}
