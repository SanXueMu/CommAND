{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["file", "file_hash", "kind", "units"],
  "properties": {
    "file": {"type": "string"},
    "file_hash": {"type": "string"},
    "kind": {"type": "string"},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit_id", "unit_type", "rows"],
        "properties": {
          "unit_id": {"type": "string"},
          "unit_type": {"const": "table"},
          "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
        }
      }
    }
  }
}
