{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["file"],
  "properties": {
    "file": {"title": "PDF 路径", "type": "string", "description": "pdf 文件路径"},
    "auto_ocr": {
      "title": "自动补文字层",
      "type": "boolean",
      "default": false,
      "description": "检测到扫描页（无文字层）时自动 OCR 补可搜索文字层后再提取"
    },
    "ocr_languages": {
      "title": "OCR 语言",
      "type": "string",
      "description": "Tesseract 语言，如 eng+chi_sim（默认）"
    },
    "ocr_jobs": {"title": "OCR 并发", "type": "integer", "description": "OCRmyPDF --jobs（默认 4）"},
    "ocr_max_pages": {"title": "OCR 最大页数", "type": "integer", "description": "超过则报错（默认 300）"},
    "ocr_timeout_s": {"title": "OCR 超时(秒)", "type": "integer", "description": "默认 900"},
    "min_chars_per_page": {
      "title": "判空阈值",
      "type": "integer",
      "description": "每页字符数低于该值视为扫描页，默认 20"
    }
  }
}
