{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "file"
  ],
  "properties": {
    "file": {
      "title": "文件路径",
      "type": "string"
    },
    "render_scale": {
      "title": "渲染倍率",
      "type": "number"
    },
    "image_max_side": {
      "title": "图片最长边像素",
      "type": "integer",
      "description": "0=不降采样（条码保真，缺省 0）"
    }
  }
}
