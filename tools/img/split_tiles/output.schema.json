{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "file",
    "tiles",
    "tile_count"
  ],
  "properties": {
    "file": {
      "type": "string"
    },
    "pages": {
      "type": "integer"
    },
    "tile_count": {
      "type": "integer"
    },
    "tile_size": {
      "type": "integer"
    },
    "overlap": {
      "type": "integer"
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "index": {
            "type": "integer"
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "w": {
            "type": "integer"
          },
          "h": {
            "type": "integer"
          },
          "image_base64": {
            "type": "string"
          }
        }
      }
    }
  }
}
