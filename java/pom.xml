<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.zthcpa.command</groupId>
    <artifactId>command-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CommAND Java Platform</name>
    <description>CommAND modular Java platform</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <modules>
        <module>command-contract</module>
        <module>command-definition</module>
        <module>command-tool-catalog</module>
        <module>command-tools</module>
        <module>command-workflow</module>
        <module>command-run</module>
        <module>command-runtime</module>
        <module>command-api</module>
        <module>command-persistence</module>
        <module>command-boot</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.zthcpa.command</groupId>
                <artifactId>command-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zthcpa.command</groupId>
                <artifactId>command-definition</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zthcpa.command</groupId>
                <artifactId>command-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zthcpa.command</groupId>
                <artifactId>command-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zthcpa.command</groupId>
                <artifactId>command-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zthcpa.command</groupId>
                <artifactId>command-run</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zthcpa.command</groupId>
                <artifactId>command-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zthcpa.command</groupId>
                <artifactId>command-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.5.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
