{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["translations", "statuses", "model", "usage", "review_count"],
  "properties": {
    "translations": {"type": "array", "items": {"type": "string"}},
    "statuses": {"type": "array", "items": {"enum": ["ok", "review"]}},
    "model": {"type": "string"},
    "usage": {"type": "object"},
    "review_count": {"type": "integer"},
    "cache_hits": {"type": "integer"}
  }
}
