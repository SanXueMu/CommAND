{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["segments"],
  "properties": {
    "segments": {"type": "array", "items": {"type": "string"}},
    "model": {"type": ["string", "null"]},
    "fallback_model": {"type": ["string", "null"]},
    "premium": {"type": ["boolean", "null"]},
    "target_lang": {"type": ["string", "null"]},
    "source_lang": {"type": ["string", "null"]},
    "terms": {"type": ["array", "string", "null"]},
    "batch_size": {"type": "integer", "minimum": 1},
    "concurrency": {"type": "integer", "minimum": 1},
    "max_batch_chars": {"type": "integer", "minimum": 100},
    "use_cache": {"type": ["boolean", "null"]}
  }
}
